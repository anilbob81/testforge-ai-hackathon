# TestForge AI -- Git Ignore
# Do NOT commit generated outputs, secrets, or cache files

# Generated reports and logs
reports/*.html
logs/
*.log

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Python environments
venv/
.venv/
env/

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Demo videos (too large for GitHub -- keep locally only)
hackathon/*.mp4
hackathon/*.mov

# Bob task session files
bob-task-*.json
bob-tasks-*.json

# Raw pytest JSON results (generated, not needed in Git)
reports/api_results_*.json
reports/ui_results_*.json
